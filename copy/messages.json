    {
      "id": "menu.about",
      "category": "content",
      "surface": "Menu · About",
      "trigger": "",
      "text": "OnPaper helps you answer one simple question: Does my CV fit this job description? … OnPaper compares your CV with a specific job description and shows you where you’re a strong fit, where you might be missing something, and what deserves your attention. OnPaper gives you recommendations, not guarantees.",
      "source": "onpaper-site/index.html:920-924"
    },
    {
      "id": "menu.how",
      "category": "content",
      "surface": "Menu · How it works",
      "trigger": "",
      "text": "Upload your CV as a PDF or DOCX, and paste the link to the job posting. Get your Fit Check: Gaps & concerns, and What to consider. Decide what to do.",
      "source": "onpaper-site/index.html:931-935"
    },
    {
      "id": "menu.privacy",
      "category": "content",
      "surface": "Menu · Privacy",
      "trigger": "",
      "text": "Your job search is personal. We don’t keep your CV or the job text. Your CV file never leaves your browser. The job link is read once. No account, no sign-up, no email, no name. In short: your CV stays yours.",
      "source": "onpaper-site/index.html:942-949"
    },
